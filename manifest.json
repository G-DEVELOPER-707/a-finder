{
  "manifest_version": 3,
  "name": "Proxy | FastVPN",
  "version": "5.0.0",
  "description": "Google Sheets va Cloudflare AI asosida tezkor javob yordamchisi.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
